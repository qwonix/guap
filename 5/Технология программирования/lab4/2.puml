@startuml
skinparam classAttributeIconSize 0

' ===== Класс предметной области =====
class File {
  - name : string
  + File(n : string)
  + getName() : string
}

' ===== Интерфейс Iterator =====
interface Iterator {
  + hasNext() : bool
  + next() : File*
}

' ===== Интерфейс Aggregate =====
interface Aggregate {
  + createIterator() : Iterator*
}

' ===== Конкретная коллекция =====
class FileCollection {
  - files : vector<File>
  + addFile(f : File) : void
  + getSize() : int
  + getFile(index : int) : File*
  + createIterator() : Iterator*
}

' ===== Конкретный итератор =====
class FileIterator {
  - collection : FileCollection*
  - index : int
  + FileIterator(c : FileCollection*)
  + hasNext() : bool
  + next() : File*
}

' ===== Наследование / реализация =====
Aggregate <|.. FileCollection
Iterator <|.. FileIterator

' ===== Ассоциации =====
FileCollection "1" o-- "*" File : contains
FileIterator --> FileCollection : iterates

@enduml