GROUP("y")
{
	MEMBERS = "y2", "y1";
}

GROUP("x")
{
	MEMBERS = "x2", "x1";
}

GROUP("s")
{
	MEMBERS = "inst6", "inst5", "inst";
}

TRANSITION_LIST("c")
{
	NODE
	{
		REPEAT = 1;
		NODE
