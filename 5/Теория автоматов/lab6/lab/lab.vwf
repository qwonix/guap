			REPEAT = 22000;
			LEVEL 0 FOR 2.5;
			LEVEL 1 FOR 2.5;
		}
		LEVEL 0 FOR 5.0;
		LEVEL 1 FOR 5.0;
		NODE
		{
			REPEAT = 10999;
			LEVEL 0 FOR 5.0;
			LEVEL 1 FOR 5.0;
		}
	}
}

