set_global_assignment -name FAMILY "MAX II"
set_global_assignment -name DEVICE EPM570T100C5
set_global_assignment -name TOP_LEVEL_ENTITY lab6
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 13.1
set_global_assignment -name VERILOG_FILE lab6.v
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_location_assignment PIN_1 -to clk
set_location_assignment PIN_3 -to q[3]
set_location_assignment PIN_4 -to q[2]
set_location_assignment PIN_5 -to q[1]
set_location_assignment PIN_6 -to q[0]
set_global_assignment -name EDA_SIMULATION_TOOL "ModelSim (Verilog)"
set_global_assignment -name EDA_TIME_SCALE "1 ps" -section_id eda_simulation
set_global_assignment -name EDA_OUTPUT_DATA_FORMAT "VERILOG HDL" -section_id eda_simulation
set_global_assignment -name SDC_FILE lab6.sdc

set_global_assignment -name LAST_QUARTUS_VERSION 13.1
set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"