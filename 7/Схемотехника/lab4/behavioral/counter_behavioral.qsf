set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to counter[2]
set_location_assignment PIN_50 -to counter[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to counter[3]
set_location_assignment PIN_28 -to cout
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cout
set_global_assignment -name VECTOR_OUTPUT_FORMAT VWF
set_global_assignment -name SIM_OVERWRITE_WAVEFORM_INPUTS OFF
