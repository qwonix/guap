set_global_assignment -name FAMILY "MAX II"
set_global_assignment -name DEVICE EPM570T100C5
set_global_assignment -name TOP_LEVEL_ENTITY counter_structural
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name LAST_QUARTUS_VERSION 13.1
set_global_assignment -name SIMULATION_MODE FUNCTIONAL
set_global_assignment -name VECTOR_WAVEFORM_FILE counter_structural.vwf
set_global_assignment -name VERILOG_FILE counter_structural.v
set_global_assignment -name VERILOG_FILE t_flip_flop.v
set_location_assignment PIN_14 -to clk
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk
set_location_assignment PIN_26 -to enable
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to enable
set_location_assignment PIN_27 -to reset
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to reset
set_location_assignment PIN_47 -to counter[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to counter[0]
set_location_assignment PIN_48 -to counter[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to counter[1]
set_location_assignment PIN_49 -to counter[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to counter[2]
set_location_assignment PIN_50 -to counter[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to counter[3]
set_location_assignment PIN_28 -to cout
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to cout
set_global_assignment -name VECTOR_OUTPUT_FORMAT VWF
set_global_assignment -name SIM_OVERWRITE_WAVEFORM_INPUTS OFF
set_global_assignment -name INCREMENTAL_VECTOR_INPUT_SOURCE counter_structural.vwf
set_global_assignment -name SDC_FILE counter_structural.sdc


set_global_assignment -name RESERVE_ALL_UNUSED_PINS_NO_OUTPUT_GND "AS INPUT TRI-STATED"

set_global_assignment -name STRATIX_DEVICE_IO_STANDARD "3.3-V LVTTL"