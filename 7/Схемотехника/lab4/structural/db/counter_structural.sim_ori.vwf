HEADER
{
 VERSION = 1;
 TIME_UNIT = ns;
 DATA_OFFSET = 0.0;
 DATA_DURATION = 1000.0;
 SIMULATION_TIME = 1000.0;
 GRID_PHASE = 0.0;
 GRID_PERIOD = 20.0;
 GRID_DUTY_CYCLE = 50;
}

SIGNAL("clk")
{
 VALUE_TYPE = NINE_LEVEL_BIT;
 SIGNAL_TYPE = SINGLE_BIT;
 WIDTH = 1;
 LSB_INDEX = -1;
 DIRECTION = INPUT;
 PARENT = "";
}

SIGNAL("counter[0]")
{
 VALUE_TYPE = NINE_LEVEL_BIT;
 SIGNAL_TYPE = SINGLE_BIT;
 WIDTH = 1;
 LSB_INDEX = -1;
 DIRECTION = OUTPUT;
 PARENT = "";
}

