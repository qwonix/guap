}

GROUP("control")
{
 MEMBERS = "clk", "reset", "enable";
}

GROUP("counter")
{
 MEMBERS = "counter[4]", "counter[3]", "counter[2]", "counter[1]", "counter[0]";
}

TRANSITION_LIST("clk")
{
 NODE
 {
 REPEAT = 1;
 LEVEL 0 FOR 10.0;
 LEVEL 1 FOR 10.0;
 LEVEL 0 FOR 10.0;
 LEVEL 1 FOR 10.0;
 LEVEL 0 FOR 10.0;
 LEVEL 1 FOR 10.0;
 LEVEL 0 FOR 10.0;
