 }
}

TRANSITION_LIST("reset")
{
 NODE
 {
 REPEAT = 1;
 LEVEL 1 FOR 30.0;
 LEVEL 0 FOR 970.0;
 }
}

TRANSITION_LIST("enable")
{
 NODE
 {
 REPEAT = 1;
 LEVEL 1 FOR 1000.0;
 }
}

DISPLAY_LINE
{
 CHANNEL = "control";
 EXPAND_STATUS = EXPANDED;
 RADIX = Binary;
 TREE_INDEX = 0;
 TREE_LEVEL = 0;
 CHILDREN = 1, 2, 3;
}
