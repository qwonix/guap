HEADER
{
 VERSION = 1; TIME_UNIT = ns; DATA_OFFSET = 0.0; DATA_DURATION = 10000.0; SIMULATION_TIME = 0.0; GRID_PHASE = 0.0; GRID_PERIOD = 100.0; GRID_DUTY_CYCLE = 50;
}
SIGNAL("x0") { VALUE_TYPE = NINE_LEVEL_BIT; SIGNAL_TYPE = SINGLE_BIT; WIDTH = 1; LSB_INDEX = -1; DIRECTION = INPUT; PARENT = ""; }
SIGNAL("x1") { VALUE_TYPE = NINE_LEVEL_BIT; SIGNAL_TYPE = SINGLE_BIT; WIDTH = 1; LSB_INDEX = -1; DIRECTION = INPUT; PARENT = ""; }
SIGNAL("x2") { VALUE_TYPE = NINE_LEVEL_BIT; SIGNAL_TYPE = SINGLE_BIT; WIDTH = 1; LSB_INDEX = -1; DIRECTION = INPUT; PARENT = ""; }
SIGNAL("y0") { VALUE_TYPE = NINE_LEVEL_BIT; SIGNAL_TYPE = SINGLE_BIT; WIDTH = 1; LSB_INDEX = -1; DIRECTION = OUTPUT; PARENT = ""; }
SIGNAL("y1") { VALUE_TYPE = NINE_LEVEL_BIT; SIGNAL_TYPE = SINGLE_BIT; WIDTH = 1; LSB_INDEX = -1; DIRECTION = OUTPUT; PARENT = ""; }
GROUP("x") { MEMBERS = "x2", "x1", "x0"; }
GROUP("y") { MEMBERS = "y1", "y0"; }
TRANSITION_LIST("x0") { NODE { REPEAT = 1; NODE { REPEAT = 4; LEVEL 0 FOR 100.0; LEVEL 1 FOR 100.0; } LEVEL 0 FOR 9200.0; } }
TRANSITION_LIST("x1") { NODE { REPEAT = 1; NODE { REPEAT = 2; LEVEL 0 FOR 200.0; LEVEL 1 FOR 200.0; } LEVEL 0 FOR 9200.0; } }
TRANSITION_LIST("x2") { NODE { REPEAT = 1; NODE { LEVEL 0 FOR 400.0; LEVEL 1 FOR 400.0; } LEVEL 0 FOR 9200.0; } }
TRANSITION_LIST("y0") { NODE { LEVEL X FOR 10000.0; } }
TRANSITION_LIST("y1") { NODE { LEVEL X FOR 10000.0; } }
DISPLAY_LINE { CHANNEL = "x"; EXPAND_STATUS = EXPANDED; RADIX = Binary; TREE_INDEX = 0; TREE_LEVEL = 0; CHILDREN = 1, 2, 3; }
DISPLAY_LINE { CHANNEL = "x2"; EXPAND_STATUS = COLLAPSED; RADIX = Binary; TREE_INDEX = 1; TREE_LEVEL = 1; PARENT = 0; }
DISPLAY_LINE { CHANNEL = "x1"; EXPAND_STATUS = COLLAPSED; RADIX = Binary; TREE_INDEX = 2; TREE_LEVEL = 1; PARENT = 0; }
DISPLAY_LINE { CHANNEL = "x0"; EXPAND_STATUS = COLLAPSED; RADIX = Binary; TREE_INDEX = 3; TREE_LEVEL = 1; PARENT = 0; }
DISPLAY_LINE { CHANNEL = "y"; EXPAND_STATUS = EXPANDED; RADIX = Binary; TREE_INDEX = 4; TREE_LEVEL = 0; CHILDREN = 5, 6; }
DISPLAY_LINE { CHANNEL = "y1"; EXPAND_STATUS = COLLAPSED; RADIX = Binary; TREE_INDEX = 5; TREE_LEVEL = 1; PARENT = 4; }
DISPLAY_LINE { CHANNEL = "y0"; EXPAND_STATUS = COLLAPSED; RADIX = Binary; TREE_INDEX = 6; TREE_LEVEL = 1; PARENT = 4; }
TIME_BAR { TIME = 800; MASTER = TRUE; }
;
