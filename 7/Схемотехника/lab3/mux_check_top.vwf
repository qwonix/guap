HEADER
{
 VERSION = 1; TIME_UNIT = ns; DATA_OFFSET = 0.0; DATA_DURATION = 800.0; SIMULATION_TIME = 0.0; GRID_PHASE = 0.0; GRID_PERIOD = 100.0; GRID_DUTY_CYCLE = 50;
}
SIGNAL("sel0") { VALUE_TYPE = NINE_LEVEL_BIT; SIGNAL_TYPE = SINGLE_BIT; WIDTH = 1; LSB_INDEX = -1; DIRECTION = INPUT; PARENT = ""; }
SIGNAL("sel1") { VALUE_TYPE = NINE_LEVEL_BIT; SIGNAL_TYPE = SINGLE_BIT; WIDTH = 1; LSB_INDEX = -1; DIRECTION = INPUT; PARENT = ""; }
SIGNAL("sel2") { VALUE_TYPE = NINE_LEVEL_BIT; SIGNAL_TYPE = SINGLE_BIT; WIDTH = 1; LSB_INDEX = -1; DIRECTION = INPUT; PARENT = ""; }
SIGNAL("y") { VALUE_TYPE = NINE_LEVEL_BIT; SIGNAL_TYPE = SINGLE_BIT; WIDTH = 1; LSB_INDEX = -1; DIRECTION = OUTPUT; PARENT = ""; }
TRANSITION_LIST("sel0") { NODE { REPEAT = 4; LEVEL 0 FOR 100.0; LEVEL 1 FOR 100.0; } }
TRANSITION_LIST("sel1") { NODE { REPEAT = 2; LEVEL 0 FOR 200.0; LEVEL 1 FOR 200.0; } }
TRANSITION_LIST("sel2") { NODE { LEVEL 0 FOR 400.0; LEVEL 1 FOR 400.0; } }
TRANSITION_LIST("y") { NODE { LEVEL X FOR 800.0; } }
DISPLAY_LINE { CHANNEL = "sel2"; EXPAND_STATUS = COLLAPSED; RADIX = Binary; TREE_INDEX = 0; TREE_LEVEL = 0; }
DISPLAY_LINE { CHANNEL = "sel1"; EXPAND_STATUS = COLLAPSED; RADIX = Binary; TREE_INDEX = 1; TREE_LEVEL = 0; }
DISPLAY_LINE { CHANNEL = "sel0"; EXPAND_STATUS = COLLAPSED; RADIX = Binary; TREE_INDEX = 2; TREE_LEVEL = 0; }
DISPLAY_LINE { CHANNEL = "y"; EXPAND_STATUS = COLLAPSED; RADIX = Binary; TREE_INDEX = 3; TREE_LEVEL = 0; }
TIME_BAR { TIME = 800; MASTER = TRUE; }
;
