@startuml
' Диаграмма классов: Облачное хранилище (FileChunk удалён)

' ---------- Вспомогательные типы ----------
class FileMetadata {
  - contentType: String
  - tags: List<String>
  + getSize(): long
}

class ScanResult {
  - infected: boolean
  - threats: List<String>
  + isClean(): boolean
}

' ---------- Интерфейсы и основные классы ----------
interface IVirusScanner {
  + scan(file: File) : ScanResult
}

class User {
  - id: UUID
  - email: String
  - name: String
  - passwordHash: String
}

class Admin {
  + manageQuota(userId: UUID, newLimit: long): void
}
Admin --|> User

class File {
  - fileId: UUID
  - name: String
  - size: long
  - owner: User
  - createdAt: Date
  - versions: List<FileVersion>
  + getMetadata(): FileMetadata
  + addVersion(v: FileVersion): void
  + markSafe(): void
}

class FileVersion {
  - versionId: int
  - createdAt: Date
  - checksum: String
  - data: byte[]
  + getData(): byte[]
}

class Folder {
  - folderId: UUID
  - name: String
  - files: List<File>
  + addFile(f: File): void
  + removeFile(f: File): void
}

class StorageQuota {
  - used: long
  - limit: long
  + check(size: long): boolean
  + reserve(size: long): void
  + release(size: long): void
}

class SharingLink {
  - url: String
  - expiresAt: Date
  - file: File
  + isValid(): boolean
  + revoke(): void
}

class FileController {
  - storage: StorageService
  - journal: Journal
  - virusScanner: IVirusScanner
  + uploadFile(user: User, version: FileMetadata): UUID
  + downloadFile(user: User, fileId: UUID): File
  + deleteFile(user: User, fileId: UUID): boolean
}

class StorageService {
  - quotaStore: Map<UUID, StorageQuota>
  + checkQuota(userId: UUID, size: long): boolean
  + saveFileVersion(fileId: UUID, version: FileVersion): boolean
  + getFile(fileId: UUID): File
  + deleteFile(fileId: UUID): void
}

class VirusScanner {
  - engineVersion: String
  + scan(file: File): ScanResult
}

' ---------- Отношения ----------
IVirusScanner <|.. VirusScanner
IVirusScanner *-- ScanResult

' композиция: File содержит версии (version — часть File)
StorageService "1" *-- "0.*" StorageQuota

' композиция: File содержит версии (version — часть File)
File "1" *-- "0.*" FileVersion

' агрегация: Folder агрегирует File
Folder "1" o-- "0.*" File

' ассоциация: User владеет File (поле owner в File)
User "1" -- "0.*" File

' ассоциация/зависимость/использование
FileController ..> StorageService
FileController ..> IVirusScanner
FileController *-- FileMetadata


' File и SharingLink
File "1" -- "0.*" SharingLink

' сервисы работают с File
StorageService "1" -- "0.*" File
VirusScanner ..> File

@enduml
