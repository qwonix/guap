@startuml
actor "Пользователь" as User
participant "FileController" as FC
participant "StorageService" as Storage
participant "Journal" as Journal

== Запрос на скачивание ==
User -> FC ++: Скачать файл
FC -> Journal : Записать событие: запрос_скачивания

FC -> Storage ++: Проверить существование файла
Storage --> FC --:
break
else Файл не найден
    FC -> User : Ошибка: файл не найден
    FC -> Journal : Записать событие: файл_не_найден
end

== Проверка разрешения на загрузку ==
FC -> Storage ++: Проверить доступ
Storage --> FC --: Результат проверки
alt
else Загрузка разрешена
    == Опциональное действие после скачивания ==
    opt Пользователь выбрал «Открыть после скачивания»
        FC -> User : Открыть файл
    end
    FC -> Journal : Записать событие: скачивание_успешно
    FC -> User : Уведомить: скачивание завершено
else Загрузка запрещена
    FC -> User : Ошибка: загрузка запрещена
    FC -> Journal : Записать событие: загрузка_запрещена
end

@enduml
